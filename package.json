{
  "name": "invoice-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "desktop/main.cjs",
  "description": "Local invoice workspace with offline document extraction",
  "author": "Invoice Studio contributors",
  "license": "MIT",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run src",
    "test:e2e": "playwright test",
    "test:desktop": "node --test desktop/*.test.cjs scripts/*.test.mjs",
    "desktop:install": "install-electron",
    "desktop:dev": "electron . --dev",
    "desktop:stage": "node scripts/stage-desktop.mjs",
    "desktop:pack": "npm run build && npm run desktop:stage && node scripts/build-desktop.mjs --dir --publish never",
    "desktop:verify": "npm run desktop:pack && npm run desktop:smoke",
    "desktop:dist": "npm run build && npm run desktop:stage && node scripts/build-desktop.mjs --publish never",
    "desktop:release": "npm run desktop:dist && npm run desktop:smoke && npm run release:checksums",
    "desktop:smoke": "node scripts/smoke-desktop.mjs",
    "release:checksums": "node scripts/checksums.mjs"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "fflate": "^0.8.3",
    "lucide-react": "^0.468.0",
    "papaparse": "^5.5.3",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.2"
  },
  "overrides": {
    "global-agent": "4.1.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.10.0",
    "@types/papaparse": "^5.3.16",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "typescript": "~5.7.3",
    "vite": "^6.1.0",
    "vitest": "^5.0.3"
  }
}
